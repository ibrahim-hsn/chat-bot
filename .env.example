# ---------------------------------------------------------------------------
# One2One — example environment configuration
#
# Copy this file to `.env` at the repo root (or per app) and adjust values.
# Never commit a real `.env`. All variables below are validated at startup by
# the corresponding app; missing/invalid values fail fast with a clear message.
#
# LAN testing (laptop + phone on the same Wi-Fi): set HOST=0.0.0.0 on the
# server, find your laptop's LAN IP (e.g. 192.168.1.25), and point the web
# app's NEXT_PUBLIC_* URLs at that IP. Never hardcode localhost in browser code.
# ---------------------------------------------------------------------------

# ----- apps/server -----
# Node runtime environment: development | test | production
NODE_ENV=development
# Interface to bind. Use 0.0.0.0 to accept LAN connections from your phone.
HOST=0.0.0.0
# Port for the REST/health server.
SERVER_PORT=4000
# Comma-separated list of allowed browser origins (CORS). No wildcard with credentials.
CORS_ORIGINS=http://localhost:3000
# Pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ----- apps/web (build-time, exposed to the browser) -----
# Base URL of the API server the browser should call.
# For LAN testing set this to e.g. http://192.168.1.25:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Base URL of the realtime (Socket.IO) server. Used from Phase 4 onward.
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
# Human-readable app name shown in the UI.
NEXT_PUBLIC_APP_NAME=One2One

# ---------------------------------------------------------------------------
# The variables below are NOT used yet. They are documented here so the shape
# of the future configuration is visible. They are added in later phases and
# are intentionally absent from the Phase 0/1 env schemas.
# ---------------------------------------------------------------------------
# MONGODB_URI=mongodb://localhost:27017/one2one   # Phase 2
# JWT_ACCESS_SECRET=change-me                      # Phase 2
# JWT_REFRESH_SECRET=change-me                     # Phase 2
# S3_ENDPOINT=                                     # Phase 6 (attachments)
